{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "prerelease": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "yucca",
      "prerelease-type": "alpha",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/yucca-api-client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/yucca-sdk/orchestration-api/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/yucca-sdk/orchestration-ui/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
