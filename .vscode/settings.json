{
  "editor.formatOnSave": true,
  "svelte.enable-ts-plugin": true,
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.removeUnusedImports": "explicit"
    }
  },
  "[javascript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.removeUnusedImports": "explicit"
    }
  },
  "[svelte]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.removeUnusedImports": "explicit"
    },
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "files.associations": {
		"*.css": "tailwindcss"
	},
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/pack-*": true
  },
  "nixEnvSelector.nixFile": "${workspaceFolder}/default.nix",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.spec.ts, ${capture}.mock.ts",
    "+page.svelte": "page.test.svelte, page.svelte.spec.ts",
    "+layout.svelte": "layout.css",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock, pnpm-workspace.yaml, .pnpmfile.cjs, .npmrc, release-please-config.json, .release-please-manifest.json, renovate.json",
    ".prettierrc": ".prettierignore, .editorconfig",
    "README.md": "LICENSE, SECURITY.md, CODE_OF_CONDUCT.md"
  },
}