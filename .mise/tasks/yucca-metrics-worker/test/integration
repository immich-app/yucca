#!/usr/bin/env bash
#MISE description="Run integration tests for yucca-metrics-worker"
set -e
source "$(dirname "$0")/../env"

# The RGW spec needs real RADOS credentials; the rest (revocation reconcile)
# only needs the compose Postgres + Redis, so it always runs.
if [[ -z "${RADOS_ENDPOINT:-}" || -z "${RADOS_ACCESS_KEY_ID:-}" || -z "${RADOS_SECRET_ACCESS_KEY:-}" ]]; then
  echo "RADOS_* not set; skipping the RGW integration spec (running the rest)"
  pnpm --filter yucca-metrics-worker test:integration --testPathIgnorePatterns=rgw "$@"
else
  pnpm --filter yucca-metrics-worker test:integration "$@"
fi
