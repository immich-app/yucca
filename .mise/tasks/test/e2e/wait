#!/usr/bin/env bash
#MISE description="Wait for development environment to be ready"
set -e
source "$(dirname "$0")/../../restic-api/env"
source "$(dirname "$0")/../../yucca-api/env"

echo Ensure dev environment is running before invoking tests.

wait_for_port() {
  local port="$1"
  local name="$2"
  local deadline=$(( $(date +%s) + 30 ))
  while ! nc -z localhost "$port" 2>/dev/null; do
    if (( $(date +%s) >= deadline )); then
      echo "Timed out waiting for $name (:$port)" >&2
      exit 1
    fi
    sleep 0.5
  done
}

wait_for_port 8092 mock-oidc-provider
wait_for_port "$RESTIC_API_PORT" restic-api
wait_for_port "$YUCCA_API_PORT" yucca-api
wait_for_port 22676 orchestration-api
wait_for_port 36033 web
