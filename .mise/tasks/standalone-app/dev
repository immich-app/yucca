#!/usr/bin/env bash
#MISE description="Run standalone-app in development mode (vite UI + tsx server)"
#MISE depends=["yucca-sdk:orchestration-ui:generate-fetch-client", "yucca-sdk:orchestration-api:build"]
set -e
export STANDALONE_WEB_PORT=${STANDALONE_WEB_PORT:-36067}
export PORT=${PORT:-22676}

pnpm --filter @futo-org/backups-standalone dev:server &
trap 'kill 0' EXIT INT TERM

pnpm --filter @futo-org/backups-standalone dev --host --port "$STANDALONE_WEB_PORT"
