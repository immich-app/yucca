#!/usr/bin/env bash
#MISE description="Run michael Go microbenchmarks"
#MISE dir="{{config_root}}/packages/michael"
set -e

# Per-request cost in-process (fleet-level `mise bench` drives real restic).
# The committed three-network fixture understates source-network lookup cost;
# point MICHAEL_BENCH_ASN_DB at a real database for representative numbers:
#   curl -fsS https://download.db-ip.com/free/dbip-asn-lite-$(date -u +%Y-%m).mmdb.gz \
#     | gunzip > /tmp/asn.mmdb
#   MICHAEL_BENCH_ASN_DB=/tmp/asn.mmdb mise run michael:bench
go test ./... -run '^$' -bench . -benchmem "$@"
