#!/usr/bin/env bash
#MISE description="Run all end-to-end tests"
set -e

backend="${RESTIC_BACKEND:-restic-api}"

cleanup() {
  lsof -ti:$RESTIC_API_PORT | xargs kill -9 2>/dev/null || true
}

trap cleanup EXIT INT TERM

# kill any existing process on the port
cleanup

# start the selected backend
case "$backend" in
  restic-api)
    pnpm --filter restic-api start:dev &
    ;;
  michael)
    (cd packages/michael && go run .) &
    ;;
  *)
    echo "Unknown backend: $backend (expected restic-api or michael)"
    exit 1
    ;;
esac

while ! nc -z localhost "$RESTIC_API_PORT" 2>/dev/null; do
  sleep 0.1
done

pnpm --filter e2e test "$@"
