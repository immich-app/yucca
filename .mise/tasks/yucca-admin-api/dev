#!/usr/bin/env bash
#MISE description="Run yucca-admin-api in development mode"
#MISE depends=["common:build"]
#MISE dir="{{config_root}}"
set -e
source "$(dirname "$0")/env"

if command -v op &>/dev/null; then
  op run --env-file="./.env" -- pnpm --filter yucca-admin-api start:dev
else
  pnpm --filter yucca-admin-api start:dev
fi
