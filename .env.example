### JWT Signing

# Generate with:
# openssl ecparam -name prime256v1 -genkey -noout -out priv.pem
# openssl pkcs8 -topk8 -nocrypt -in priv.pem -out priv-pkcs8.pem
# openssl ec -in priv.pem -pubout -out pub.pem

# JWT_PRIVATE_KEY=
# JWT_EXPIRES_IN=

