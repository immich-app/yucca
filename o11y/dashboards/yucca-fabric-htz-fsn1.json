      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (target,name) (rate(junos_interface_transmit_errors{name=~\"ae.+|et-.+\"}[5m]))",
          "legendFormat": "TX err {{target}} {{name}}",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        },
        {
          "expr": "sum by (target,name) (rate(junos_interface_receive_errors{name=~\"ae.+|et-.+\"}[5m]))",
          "legendFormat": "RX err {{target}} {{name}}",
          "refId": "B",
          "datasource": {
            "uid": "$datasource"
          }
        },
        {
          "expr": "sum by (target,name) (rate(junos_interface_transmit_drops{name=~\"ae.+|et-.+\"}[5m]))",
          "legendFormat": "TX drop {{target}} {{name}}",
          "refId": "C",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 10,
      "datasource": {
        "uid": "$datasource"
