{
  "uid": "yucca-fabric-htz-fsn1",
  "title": "Fabric: htz-fsn1 overview",
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Fabric throughput INTO switch port (sFlow 5s, bits/s)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sflow_ifinoctets{port!=\"\"}*8",
          "legendFormat": "{{port}}",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 1,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Fabric throughput OUT of switch port (sFlow 5s, bits/s)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
