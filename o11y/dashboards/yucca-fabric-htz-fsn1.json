      "targets": [
        {
          "expr": "count(up{job=\"kubelet\"} == 1)",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 8,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "Metrics ingest (samples/s)",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "sum(rate(vm_rows_inserted_total[1m]))",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 9,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Interface errors + drops (pkt/s)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
