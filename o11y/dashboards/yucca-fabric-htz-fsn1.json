          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sflow_ifoutoctets{port!=\"\"}*8",
          "legendFormat": "{{port}}",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 2,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Interface throughput TX (NETCONF 60s, bits/s)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(junos_interface_transmit_bytes{name=~\"ae[0-9]+|et-.+|xe-.+|irb.+\"}[2m])*8",
          "legendFormat": "{{target}} {{name}}",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 3,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "timeseries",
      "title": "Interface throughput RX (NETCONF 60s, bits/s)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "gradientMode": "none"
          }
        },
        "overrides": []
