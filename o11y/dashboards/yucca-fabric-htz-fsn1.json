      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(junos_interface_receive_bytes{name=~\"ae[0-9]+|et-.+|xe-.+|irb.+\"}[2m])*8",
          "legendFormat": "{{target}} {{name}}",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 4,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "BGP sessions up",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "sum(junos_bgp_session_up)",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
      ],
      "id": 5,
      "datasource": {
        "uid": "$datasource"
      }
    },
    {
      "type": "stat",
      "title": "Red alarms",
      "gridPos": {
        "x": 4,
        "y": 16,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "sum(junos_alarms_red_count)",
          "refId": "A",
          "datasource": {
            "uid": "$datasource"
          }
        }
