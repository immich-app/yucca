          "expr": "max(100 * (ceph_bluefs_db_used_bytes{cluster=~\"$cluster\"} / ceph_bluefs_db_total_bytes{cluster=~\"$cluster\"}) * on(ceph_daemon) group_left(hostname) ceph_osd_metadata{cluster=~\"$cluster\", device_class=\"hdd\"})",
