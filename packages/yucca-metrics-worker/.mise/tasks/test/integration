#!/usr/bin/env bash
#MISE description="Run integration tests for yucca-metrics-worker"
set -e
source "$(dirname "$0")/../env"

if [[ -z "${RADOS_ENDPOINT:-}" || -z "${RADOS_ACCESS_KEY_ID:-}" || -z "${RADOS_SECRET_ACCESS_KEY:-}" ]]; then
  echo "RADOS_* not set; skipping yucca-metrics-worker integration tests"
  exit 0
fi

pnpm --filter yucca-metrics-worker test:integration "$@"
