  "info": {
    "title": "yucca",
    "description": "yucca API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "AuthDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string",
            "nullable": true
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "sessionId",
          "features"
        ]
      },
      "ConnectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "immich",
              "restic"
            ]
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string",
            "nullable": true
          },
          "repositoryCount": {
            "type": "number"
          },
          "sizeBytes": {
            "type": "number",
            "description": "Rolled-up storage across this connection’s repositories (RGW size)."
          },
          "objectCount": {
            "type": "number",
            "description": "Rolled-up object count across this connection’s repositories."
          },
          "billableBytes": {
            "type": "number",
            "description": "Billed bytes: per-object min-size floor applied (immich exempt)."
          }
        },
        "required": [
          "id",
          "type",
          "name",
          "createdAt",
          "repositoryCount",
          "sizeBytes",
          "objectCount",
          "billableBytes"
        ]
      },
      "ConnectionListResponseDto": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionDto"
            }
          }
        },
        "required": [
          "connections"
        ]
      },
      "ConnectionCreateRequestDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "immich",
              "restic"
            ]
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name"
        ]
      },
      "ConnectionResponseDto": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/ConnectionDto"
          }
        },
        "required": [
          "connection"
        ]
      },
      "ConnectionResticRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name (defaults to a generated one)."
          },
          "worm": {
            "type": "boolean",
            "description": "Enable write-once (WORM) on the repository."
          },
          "expiresIn": {
            "type": "string",
            "description": "Token lifetime (e.g. \"90d\"), capped at RESTIC_JWT_MAX_EXPIRES_IN."
          },
          "label": {
            "type": "string",
            "description": "Human label for the minted access key."
          }
        }
      },
      "RepositoryMetricsDto": {
        "type": "object",
        "properties": {
          "lastBackup": {
            "type": "string"
          },
          "lastSuccessfulBackup": {
            "type": "string"
          },
          "lastBackupDuration": {
            "type": "number"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "sizeBytes"
        ]
      },
      "RepositoryMeterDto": {
        "type": "object",
        "properties": {
          "sizeBytes": {
            "type": "number"
          },
          "objectCount": {
            "type": "number"
          },
          "lastUpdated": {
            "type": "string"
          }
        },
        "required": [
          "sizeBytes",
          "objectCount"
        ]
      },
      "RepositoryWithMetricsDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "worm": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "connectionType": {
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/RepositoryMetricsDto"
          },
          "meter": {
            "$ref": "#/components/schemas/RepositoryMeterDto"
          }
        },
        "required": [
          "id",
          "worm",
          "name",
          "connectionId",
          "connectionType",
          "metrics"
        ]
      },
      "ConnectionResticResponseDto": {
        "type": "object",
        "properties": {
          "connection": {
            "$ref": "#/components/schemas/ConnectionDto"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositoryWithMetricsDto"
          },
          "url": {
            "type": "string",
            "description": "rest: URL with the embedded restic JWT."
          },
          "jti": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "connection",
          "repository",
          "url",
          "jti",
          "expiresAt"
        ]
      },
      "ConnectionUpdateRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "ConnectionAdoptRequestDto": {
        "type": "object",
        "properties": {
          "repositoryIds": {
            "description": "Repositories to move from the default connection to this one",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "repositoryIds"
        ]
      },
      "SubmitBackupEndRequestDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "number"
          }
        },
        "required": [
          "success",
          "durationMs"
        ]
      },
      "SubmitUpdateSizeRequestDto": {
        "type": "object",
        "properties": {
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "sizeBytes"
        ]
      },
      "SubmitStructuredLogRequestDto": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "summary",
          "data"
        ]
      },
      "RepositoryMetricsHistoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "started": {
            "type": "string"
          },
          "backup": {
            "type": "string"
          },
          "successfulBackup": {
            "type": "string"
          },
          "backupDuration": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "repositoryId",
          "createdAt"
        ]
      },
      "RepositoryMetricsHistoryListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryMetricsHistoryDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items"
        ]
      },
      "RepositoryCreateRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "worm": {
            "type": "boolean"
          },
          "connectionId": {
            "type": "string",
            "description": "Owned connection to create the repository under (defaults to the session/default connection)."
          }
        },
        "required": [
          "name",
          "worm"
        ]
      },
      "RepositoryCreateResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/RepositoryWithMetricsDto"
          }
        },
        "required": [
          "repository"
        ]
      },
      "RepositoryGetResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/RepositoryWithMetricsDto"
          }
        },
        "required": [
          "repository"
        ]
      },
      "RepositoryListResponseDto": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryWithMetricsDto"
            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "RepositoryUpdateRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "worm": {
            "type": "boolean"
          }
        }
      },
      "RepositoryUpdateResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/RepositoryWithMetricsDto"
          }
        },
        "required": [
          "repository"
        ]
      },
      "ResticUrlRequestDto": {
        "type": "object",
        "properties": {
          "expiresIn": {
            "type": "string",
            "description": "Token lifetime (e.g. \"90d\"). Defaults to RESTIC_JWT_EXPIRES_IN, capped at RESTIC_JWT_MAX_EXPIRES_IN."
          },
          "label": {
            "type": "string",
            "description": "Human label for this access key (shown in the token list)."
          }
        }
      },
      "RepositoryCreateResticUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "rest: URL with the embedded restic JWT — paste into `restic -r`."
          },
          "jti": {
            "type": "string",
            "description": "The minted token id, for revocation."
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "jti",
          "expiresAt"
        ]
      },
      "ResticTokenDto": {
        "type": "object",
        "properties": {
          "jti": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "connectionId": {
            "type": "object",
            "nullable": true
          },
          "mintedBy": {
            "type": "string",
            "description": "'user' or 'admin'"
          },
          "label": {
            "type": "object",
            "nullable": true
          },
          "expiresAt": {
            "type": "string"
          },
          "revokedAt": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
