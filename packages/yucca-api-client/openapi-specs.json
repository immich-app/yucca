  "info": {
    "title": "yucca",
    "description": "yucca API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "AuthDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "connectionId": {
            "type": "string",
            "nullable": true
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "sessionId",
          "features"
        ]
      },
      "TicketAction": {
        "type": "string",
        "enum": [
          "repository.delete",
          "repository.disable-worm"
        ]
      },
      "TicketCreateRequestDto": {
        "type": "object",
        "properties": {
          "action": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketAction"
              }
            ]
          },
          "repositoryId": {
            "type": "string",
            "description": "Repository the ticket is bound to"
          }
        },
        "required": [
          "action",
          "repositoryId"
        ]
      },
      "TicketCreateResponseDto": {
        "type": "object",
        "properties": {
          "redirectTo": {
            "type": "string",
            "description": "IdP URL the browser must be sent to"
          }
        },
        "required": [
          "redirectTo"
        ]
      },
      "RepositoryMetricsDto": {
        "type": "object",
        "properties": {
          "lastBackup": {
            "type": "string"
          },
          "lastSuccessfulBackup": {
            "type": "string"
          },
          "lastBackupDuration": {
            "type": "number"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "sizeBytes"
        ]
      },
      "RepositoryMeterDto": {
        "type": "object",
        "properties": {
          "sizeBytes": {
            "type": "number"
          },
          "objectCount": {
            "type": "number"
          },
          "lastUpdated": {
            "type": "string"
          }
        },
        "required": [
          "sizeBytes",
          "objectCount"
        ]
      },
      "TicketDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TicketAction"
              }
            ]
          },
          "repositoryId": {
            "type": "string"
          },
          "repositoryName": {
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/RepositoryMetricsDto"
          },
          "meter": {
            "$ref": "#/components/schemas/RepositoryMeterDto"
          }
        },
        "required": [
          "id",
          "action",
          "repositoryId",
          "repositoryName",
          "metrics"
        ]
      },
      "MetaConfigDto": {
        "type": "object",
        "properties": {
          "restic_pack_size_mib": {
            "type": "number"
          },
          "connections_math": {
            "type": "string",
            "description": "Client-evaluated expression: integers, cores, min, max, + - * /"
          }
        },
        "required": [
          "restic_pack_size_mib",
          "connections_math"
        ]
      },
      "MetaConfigOverridesDto": {
        "type": "object",
        "properties": {
          "restic_pack_size_mib": {
            "type": "number"
          },
          "connections_math": {
            "type": "string",
            "description": "Client-evaluated expression: integers, cores, min, max, + - * /"
          }
        }
      },
      "MetaClusterDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "cluster_config": {
            "description": "Per-cluster overrides of the global and site config",
            "allOf": [
              {
                "$ref": "#/components/schemas/MetaConfigOverridesDto"
              }
            ]
          }
        },
        "required": [
          "code",
          "display_name",
          "cluster_config"
        ]
      },
      "MetaSiteDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rest_url": {
            "type": "string"
          },
          "default_cluster": {
            "type": "string"
          },
          "site_config": {
            "description": "Per-site overrides of the global config",
            "allOf": [
              {
                "$ref": "#/components/schemas/MetaConfigOverridesDto"
              }
            ]
          },
          "clusters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaClusterDto"
            }
          }
        },
        "required": [
          "code",
          "display_name",
          "description",
          "rest_url",
          "default_cluster",
          "site_config",
          "clusters"
        ]
      },
      "MetaResponseDto": {
        "type": "object",
        "properties": {
          "api_root": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/MetaConfigDto"
          },
          "default_site": {
            "type": "string"
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaSiteDto"
            }
          }
        },
        "required": [
          "api_root",
          "config",
          "default_site",
          "sites"
        ]
      },
      "ConnectionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "immich",
              "standalone",
              "restic"
            ]
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string",
            "nullable": true
          },
          "repositoryCount": {
            "type": "number"
          },
          "sizeBytes": {
            "type": "number",
            "description": "Rolled-up storage across this connection’s repositories (RGW size)."
          },
          "objectCount": {
            "type": "number",
            "description": "Rolled-up object count across this connection’s repositories."
          },
          "billableBytes": {
            "type": "number",
