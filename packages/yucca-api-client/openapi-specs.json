  "info": {
    "title": "yucca",
    "description": "yucca API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "AuthDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "sessionId"
        ]
      },
      "RepositoryMetricsDto": {
        "type": "object",
        "properties": {
          "lastUpload": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "sizeBytes"
        ]
      },
      "RepositoryWithMetricsDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "worm": {
            "type": "boolean"
          },
          "metrics": {
            "$ref": "#/components/schemas/RepositoryMetricsDto"
          }
        },
        "required": [
          "id",
          "worm",
          "metrics"
        ]
      },
      "RepositoryCreateResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/RepositoryWithMetricsDto"
          }
        },
        "required": [
          "repository"
        ]
      },
      "RepositoryListResponseDto": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryWithMetricsDto"
            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "RepositoryCreateResticUrlDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  }
}