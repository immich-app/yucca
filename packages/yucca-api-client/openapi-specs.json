    "/api/repository": {
      "post": {
        "operationId": "createRepository",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryCreateResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Repository"
        ]
      },
      "get": {
        "operationId": "getRepositories",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryListResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Repository"
        ]
      }
    },
    "/api/repository/{id}/restic": {
      "post": {
        "operationId": "createResticUrl",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryCreateResticUrlDto"
                }
              }
            }
          }
        },
        "tags": [
