{
  "name": "@futo-org/backups-orchestrator-api",
  "repository": "https://github.com/immich-app/yucca",
  "version": "0.5.0",
  "description": "Backups orchestrator (API)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "nest build",
    "test": "jest",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "dev": "nodemon bin/server.ts",
    "start": "ts-node bin/server.ts",
    "sync:openapi": "ts-node bin/sync-openapi.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Source First License 1.1",
  "packageManager": "pnpm@10.28.1",
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/websockets": "^11.0.0"
  },
  "dependencies": {
    "@futo-org/restic-wrapper": "catalog:",
    "@nestjs/event-emitter": "catalog:",
    "better-sqlite3": "catalog:",
    "class-validator": "catalog:",
    "cookie": "catalog:",
    "cron": "catalog:",
    "event-iterator": "catalog:",
    "eventsource-client": "catalog:",
    "express": "catalog:",
    "kysely": "catalog:",
    "nestjs-kysely": "catalog:",
    "openid-client": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "tail": "catalog:",
    "@futo-org/backups-api-client": "workspace:^"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/tail": "catalog:",
    "jest": "catalog:",
    "nodemon": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:"
  },
  "files": [
    "dist"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
