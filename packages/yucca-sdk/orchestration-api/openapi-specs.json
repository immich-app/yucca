            "type": "string"
          },
          "worm": {
            "type": "boolean"
          },
          "metrics": {
            "$ref": "#/components/schemas/RepositoryMetricsDto"
          },
          "local": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RepositoryMetadataDto"
              }
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/RepositoryMetadataDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "worm",
          "metrics"
        ]
      },
      "RepositoryCreateResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
