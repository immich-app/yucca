            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "BackendType": {
        "type": "string",
        "enum": [
          "yucca",
          "local",
          "s3"
        ]
      },
      "BackendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BackendType"
              }
            ]
          },
          "isOnline": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "isOnline"
        ]
      },
