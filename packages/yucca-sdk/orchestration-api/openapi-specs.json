  "info": {
    "title": "yucca",
    "description": "yucca SDK",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:22676"
    }
  ],
  "components": {
    "schemas": {
      "RepositoryMetricsDto": {
        "type": "object",
        "properties": {
          "lastBackup": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          }
        },
        "required": [
          "sizeBytes"
        ]
      },
      "BackendType": {
        "type": "string",
        "enum": [
          "yucca",
          "local",
          "s3"
        ]
      },
      "RepositoryBackendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BackendType"
              }
            ]
          },
          "online": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type",
          "online"
        ]
      },
      "RepositoryBackendsDto": {
        "type": "object",
        "properties": {
          "primary": {
            "$ref": "#/components/schemas/RepositoryBackendDto"
          },
          "secondary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryBackendDto"
            }
          }
        },
        "required": [
          "primary",
          "secondary"
        ]
      },
      "RepositoryConfigurationDto": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "paths"
        ]
      },
      "LocalRepositoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "worm": {
            "type": "boolean"
          },
          "metrics": {
            "$ref": "#/components/schemas/RepositoryMetricsDto"
          },
          "backends": {
            "$ref": "#/components/schemas/RepositoryBackendsDto"
          },
          "configuration": {
            "$ref": "#/components/schemas/RepositoryConfigurationDto"
          }
        },
        "required": [
          "id",
          "worm",
          "metrics"
        ]
      },
      "RepositoryCreateResponseDto": {
        "type": "object",
        "properties": {
          "repository": {
            "$ref": "#/components/schemas/LocalRepositoryDto"
          }
        },
        "required": [
          "repository"
        ]
      },
      "RepositoryListResponseDto": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalRepositoryDto"
            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "RepositoryPathRequestDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "BackendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BackendType"
              }
            ]
          },
          "isOnline": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "isOnline"
        ]
      },
      "BackendsResponseDto": {
        "type": "object",
        "properties": {
          "backends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackendDto"
            }
          }
        },
        "required": [
          "backends"
        ]
      },
      "FilesystemListingItemDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "isDirectory": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "path",
          "isDirectory"
        ]
      },
      "FilesystemListingResponseDto": {
        "type": "object",
        "properties": {
          "parent": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilesystemListingItemDto"
            }
          }
        },
        "required": [
          "parent",
          "path",
          "items"
        ]
      }
    }
