  "info": {
    "title": "yucca",
    "description": "yucca SDK",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:22676"
    }
  ],
  "components": {
    "schemas": {
      "BackendType": {
        "type": "string",
        "enum": [
          "yucca",
          "local",
          "s3"
        ]
      },
      "BackendDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BackendType"
              }
            ]
          },
          "isOnline": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "isOnline"
        ]
      },
      "BackendsResponseDto": {
        "type": "object",
        "properties": {
          "backends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackendDto"
            }
          }
        },
        "required": [
          "backends"
        ]
      },
      "CreateLocalBackendRequestDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "BackendResponseDto": {
        "type": "object",
        "properties": {
          "backend": {
            "$ref": "#/components/schemas/BackendDto"
          }
        },
        "required": [
          "backend"
        ]
      },
      "FilesystemListingItemDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "isDirectory": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "isDirectory"
        ]
      },
      "FilesystemListingResponseDto": {
        "type": "object",
        "properties": {
          "parent": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilesystemListingItemDto"
            }
          }
        },
        "required": [
          "parent",
          "path",
          "items"
        ]
      },
      "ImmichLibraryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "importPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusionPatterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "importPaths",
          "exclusionPatterns"
        ]
      },
      "ImmichStateDto": {
        "type": "object",
        "properties": {
          "dataPath": {
            "type": "string"
          },
          "dataFolders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "libraries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImmichLibraryDto"
            }
          }
        },
        "required": [
          "dataPath",
          "dataFolders",
          "libraries"
        ]
      },
      "ImmichIntegrationConfigurationDto": {
        "type": "object",
        "properties": {
          "dataFolders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "backupConfiguration": {
            "type": "boolean"
          },
          "libraries": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "all"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
