{
  "name": "@futo-org/backups-orchestrator-ui",
  "repository": "https://github.com/immich-app/yucca",
  "description": "Backups orchestrator (UI library)",
  "version": "0.25.0",
  "license": "Source First License 1.1",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "vite build && npm run prepack",
    "preview": "vite preview --port 4174",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest --run",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:create": "playwright codegen http://localhost:36066",
    "generate:fetch-client": "oazapfts --optimistic ../orchestration-api/openapi-specs.json src/lib/fetch-client.ts"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/fetch-client.d.ts",
      "default": "./dist/fetch-client.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/d3": "catalog:",
    "@types/lodash.debounce": "catalog:",
    "@types/luxon": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "oazapfts": "catalog:",
    "playwright": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  },
  "keywords": [
    "svelte"
  ],
  "dependencies": {
    "@immich/ui": "catalog:",
    "@mdi/js": "catalog:",
    "@oazapfts/runtime": "catalog:",
    "@tanstack/svelte-query": "catalog:",
    "cron-validate": "catalog:",
    "cronstrue": "catalog:",
    "lodash.debounce": "catalog:",
    "luxon": "catalog:",
    "socket.io-client": "catalog:",
    "@futo-org/backups-api-client": "workspace:^"
  }
}
