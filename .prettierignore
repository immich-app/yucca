# Infrastructure subtrees own their own format conventions (yamllint +
# ansible-lint inside ansible/ceph/; tofu fmt inside tf/). Prettier on
# ansible YAML is opinionated in ways that conflict with Jinja2 + ansible
# task structure, so these subtrees are exempt from root prettier checks.
kubernetes/
ansible/
tf/

# Helm charts: templates are Go-templated YAML (not parseable by prettier),
# and values/Chart files follow helm conventions. Validated by helm template
# + kubeconform via `mise k8s:validate` instead.
charts/

# yuctl warp manifests: Go-templated YAML embedded into the binary (//go:embed
# in internal/warp/session.go). Worth ignoring rather than fixing up, because
# prettier --write rewrites `{{ .Name }}` to `{ { .Name } }` (legal YAML, read
# as a nested flow mapping) and text/template then emits it literally.
packages/yuctl/internal/warp/manifests/

# Grafana dashboard exports: machine-generated JSON, round-tripped through
# the Grafana UI — not worth format churn.
o11y/dashboards/

