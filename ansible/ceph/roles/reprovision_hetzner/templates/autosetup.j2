## Hetzner installimage autosetup for {{ cluster_name }} SX295 ceph nodes ({{ cluster_domain }}).
## Rendered by reprovision_hetzner for {{ inventory_hostname }}. DO NOT hand-edit.
## Hardware: SX295 - 2x NVMe (OS, RAID-1) + 14x SATA HDD (Ceph OSDs, UNTOUCHED here).
## Applied base-OS-only: installimage -a -c /autosetup  (NO -x chroot post-install;
## db-slot/ssd-osd LVs, packages and sysctl are done post-boot by ceph_deploy
## convergence -- see roles/ceph_deploy/tasks/lvm-setup.yml and roles/baseline).

DRIVE1 /dev/nvme0n1
DRIVE2 /dev/nvme1n1

SWRAID 1
SWRAIDLEVEL 1

BOOTLOADER grub

HOSTNAME {{ inventory_hostname }}.{{ cluster_domain }}

{% if reprovision_boot_mode == 'uefi' %}
PART /boot/efi esp 256M
{% endif %}
PART /boot ext4 1G
PART lvm   vg0  all

LV vg0 swap   swap     swap  32G
LV vg0 root   /        ext4  100G
LV vg0 var    /var     ext4  200G
LV vg0 varlog /var/log ext4  50G

IMAGE {{ reprovision_image }}
