#!/usr/sbin/nft -f
# Ceph node firewall - managed by Ansible (security role)
# Allows only Ceph services + SSH from trusted networks. Drops everything else.

# Replace ONLY our own table. A global `flush ruleset` would also wipe the
# podman/docker/fail2ban tables (cephadm runs podman on these nodes) and would
# make the no-op guard never match. `table inet filter` creates it if absent,
# then delete+re-add atomically replaces just our rules.
table inet filter
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback
        iifname "lo" accept
{% for ifc in ceph_firewall_trusted_ifaces %}

        # Trusted interface (closed cluster L2): accept wholesale so return
        # traffic of pre-firewall established flows cannot hit the drop policy.
        iifname "{{ ifc }}" accept
{% endfor %}

        # Established/related
        ct state established,related accept

        # ICMP (ping, MTU discovery)
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # SSH
{% if ceph_firewall_ssh_any_source | bool %}
        tcp dport 22 accept
{% endif %}

{% if ceph_firewall_rgw_any_source | bool %}
        # RGW / S3 (all sources)
        tcp dport {{ ceph_firewall_rgw_port }} accept
{% endif %}

{% for net in ceph_firewall_trusted_networks %}
{% if not (ceph_firewall_rgw_any_source | bool) %}
        # RGW / S3 (restricted to trusted networks)
        ip saddr {{ net }} tcp dport {{ ceph_firewall_rgw_port }} accept
{% endif %}
        # --- Trusted network: {{ net }} ---

{% if not (ceph_firewall_ssh_any_source | bool) %}
        # SSH (restricted to trusted networks)
        ip saddr {{ net }} tcp dport 22 accept
{% endif %}

        # Ceph MON
{% for port in ceph_firewall_mon_ports %}
        ip saddr {{ net }} tcp dport {{ port }} accept
{% endfor %}

        # Ceph OSD
        ip saddr {{ net }} tcp dport {{ ceph_firewall_osd_port_range }} accept

        # Dashboard
        ip saddr {{ net }} tcp dport {{ ceph_firewall_dashboard_port }} accept

        # Monitoring stack
        ip saddr {{ net }} tcp dport {{ ceph_firewall_prometheus_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_grafana_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_alertmanager_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_node_exporter_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_mgr_exporter_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_ceph_exporter_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_scrub_exporter_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_fluentbit_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_service_discovery_port }} accept
{% if ceph_firewall_iscsi_enabled | bool %}

        # iSCSI gateway
        ip saddr {{ net }} tcp dport {{ ceph_firewall_iscsi_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_iscsi_api_port }} accept
{% endif %}
{% if ceph_firewall_nfs_enabled | bool %}

        # NFS-Ganesha
        ip saddr {{ net }} tcp dport {{ ceph_firewall_nfs_port }} accept
        ip saddr {{ net }} tcp dport {{ ceph_firewall_nfs_mgmt_port }} accept
{% endif %}
{% endfor %}

        # Count + log every drop over NFLOG to ulogd2 (role defaults have
        # the why); no printk, so nothing lands in kmsg or the journal.
        counter log prefix "nftables-drop" group {{ ceph_firewall_droplog_group }} snaplen {{ ceph_firewall_droplog_snaplen }} queue-threshold {{ ceph_firewall_droplog_threshold }}
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
