# Managed by ansible (roles/fluentbit) - do not edit on the node.
# journald -> drop noise -> tag -> o11y VictoriaLogs over the NetBird overlay.

[SERVICE]
    Flush                     5
    Daemon                    Off
    Log_Level                 info
    Parsers_File              parsers.conf
    HTTP_Server               On
    HTTP_Listen               0.0.0.0
    HTTP_Port                 {{ ceph_fluentbit_http_port }}
    storage.path              /var/lib/fluent-bit/storage
    storage.sync              normal
    storage.checksum          off
    storage.backlog.mem_limit 64M

[INPUT]
    Name              systemd
    Tag               host.*
    # Cursor survives restarts, so a reboot resumes instead of re-reading.
    DB                /var/lib/fluent-bit/journal.db
    DB.Sync           normal
    # VictoriaLogs reserves _-prefixed names for _msg/_time/_stream.
    Strip_Underscores On
    Read_From_Tail    On
    Max_Entries       5000
    storage.type      filesystem

# ~2.4M lines/hour fleet-wide is nearly all mon/mgr status chatter. The mon
# cluster health channel is not matched.
[FILTER]
    Name    grep
    Match   host.*
    Exclude MESSAGE {{ ceph_fluentbit_drop_regex }}

[FILTER]
    Name   record_modifier
    Match  host.*
    Record cluster {{ ceph_fluentbit_cluster_label }}
    Record site {{ ceph_fluentbit_site_label }}
    Record env {{ ceph_fluentbit_env_label }}

[OUTPUT]
    Name                     http
    Match                    host.*
    Host                     {{ ceph_fluentbit_o11y_host }}
    Port                     {{ ceph_fluentbit_o11y_port }}
    # Real Let's Encrypt cert on the gateway.
    TLS                      On
    TLS.Verify               On
    URI                      /insert/jsonline?_msg_field=MESSAGE&_time_field=date&_stream_fields={{ ceph_fluentbit_stream_fields }}
    Format                   json_lines
    Json_date_format         iso8601
    Json_date_key            date
    compress                 gzip
    # Retry forever: an overlay flap should queue, not lose.
    Retry_Limit              False
    storage.total_limit_size {{ ceph_fluentbit_buffer_limit }}
