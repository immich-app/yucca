# Managed by ansible (roles/vector) - do not edit on the node.
#
# journald -> drop the known-noise streams -> tag with the metrics identity ->
# o11y VictoriaLogs over the NetBird overlay.
#
# Why the elasticsearch sink and not the journald one: VictoriaLogs' native
# journald endpoint (/insert/journald) is not routed by o11y's mesh vmauth, and
# opening it is an o11y-side change. /insert/elasticsearch/ is routed.

data_dir: /var/lib/vector

api:
  enabled: false

sources:
  journal:
    type: journald
    # Ship across reboots, not just the current boot. Vector checkpoints its
    # read position in data_dir, so a restart resumes rather than re-reading.
    current_boot_only: false

transforms:
  # Most of the fleet's ~2.4M lines/hour is mon/mgr status chatter with no
  # diagnostic value. Dropping it here keeps it off the overlay and out of
  # retention. The cluster health channel is deliberately NOT matched.
  clean:
    type: filter
    inputs: [journal]
    condition: '!match(string!(.message), r''{{ ceph_vector_drop_pattern }}'')'

  # Same identity tags the metrics pipeline stamps, so logs and metrics join.
  tag:
    type: remap
    inputs: [clean]
    source: |
      .cluster = "{{ ceph_vector_cluster_label }}"
      .site    = "{{ ceph_vector_site_label }}"
      .env     = "{{ ceph_vector_env_label }}"

  # The agent's own health. Exposed for the netops vmagent; the scrape job is
  # a follow-up.
  internal:
    type: internal_metrics

sinks:
  o11y:
    type: elasticsearch
    inputs: [tag]
    endpoints: ["{{ ceph_vector_endpoint }}"]
    api_version: v8
    compression: gzip
    # vmauth fronts vlinsert; there is no ES health endpoint behind it.
    healthcheck:
      enabled: false
    buffer:
      type: disk
      max_size: {{ ceph_vector_buffer_bytes }}
      # Backpressure rather than silent loss when o11y is unreachable.
      when_full: block
    query:
      _msg_field: message
      _time_field: timestamp
      _stream_fields: "{{ ceph_vector_stream_fields }}"

  metrics:
    type: prometheus_exporter
    inputs: [internal]
    address: "0.0.0.0:{{ ceph_vector_metrics_port }}"
