# {{ ansible_managed }}
# Sets CPU governor on every boot — before Ceph OSDs start.
[Unit]
Description=Set CPU governor to {{ ceph_cpu_governor }}
Before=ceph-osd.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo {{ ceph_cpu_governor }} > "$g" 2>/dev/null || true; done'

[Install]
WantedBy=multi-user.target
