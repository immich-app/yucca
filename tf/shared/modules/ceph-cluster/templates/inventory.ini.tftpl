#
# Ceph ${cluster_name} cluster — ${domain}
# TF-GENERATED — do not edit by hand. Source: tf/deployment/<partition>/<region>/ceph/
#
[ceph_nodes]
%{ for h in hosts ~}
${h.hostname_short} ansible_host=${h.bond_ip}
%{ endfor ~}

[ceph_nodes:vars]
ansible_user=${ansible_ssh_user}
ansible_ssh_private_key_file=${ansible_ssh_key}

# MON/MGR nodes — currently all nodes
[ceph_mon]
%{ for h in hosts ~}
${h.hostname_short}
%{ endfor ~}

# Bootstrap node — first MON/MGR, runs cephadm bootstrap
[ceph_bootstrap]
${bootstrap_host.hostname_short}

# Joined nodes — added to cluster post-bootstrap
[ceph_join]
%{ for h in join_hosts ~}
${h.hostname_short}
%{ endfor ~}
