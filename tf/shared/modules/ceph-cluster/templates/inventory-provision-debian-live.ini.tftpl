#
# PROVISION inventory — Ceph ${cluster_name} cluster @ ${domain}
# TF-GENERATED — do not edit by hand. Source: tf/deployment/<env>/ceph/
#
# Runs against the Debian 12 live image on each node BEFORE the first boot
# into the installed OS. Credentials are the live image's user/pass, not
# the ansible-iac key (which isn't on the box yet).
#
# Uses the same inventory_hostname as inventory.ini so host_vars/ auto-load
# (bond_ip, hostname_short, SAS path, etc.). Only SSH credentials differ.
#
# Usage:
#   CEPH_ENV=inventories/<cluster>/inventory-provision.ini \
#     scripts/ansible-play.sh provision.yml -e confirm_wipe=true
#
[provision_targets]
%{ for h in hosts ~}
${h.hostname_short} ansible_host=${h.bond_ip}
%{ endfor ~}

[provision_targets:vars]
ansible_user=user
ansible_ssh_pass=live
ansible_become=true
ansible_become_method=sudo
ansible_become_pass=live
