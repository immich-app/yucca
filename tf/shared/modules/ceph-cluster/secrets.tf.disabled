# tf/shared/modules/ceph-cluster/secrets.tf.disabled
#
# DORMANT — TF-managed onepassword_item resources for per-cluster password
# secrets. Currently disabled; today's items are created via `op item create`
# (see ansible/ceph/docs/adding-a-cluster.md §6).
#
# To re-enable:
#   1. Rename this file to `secrets.tf` (TF only loads `*.tf` / `*.tf.json`).
#   2. Uncomment the `onepassword` provider in
#      tf/deployment/dev/ceph/versions.tf (and any other deployment stacks).
#   3. `mise run tf:init` to download the provider.
#   4. `mise run tf:plan` to preview — should show creation of N×5 password
#      items (N = clusters in clusters.auto.tfvars × 5 password types).
#   5. `mise run tf:apply` once the plan looks right.
#
# Pre-conditions (per ADR-009):
#   - The TF service account has WRITE access to var.vault. The current
#     org-wide superuser SA (`yucca_futo_1pass_superuser_service_account`)
#     would work, but the intent is to land a dedicated ceph-scoped SA
#     first so the blast radius of TF-managed item creation is bounded
#     to ceph-project items only.
#   - The vault declared in var.vault must already exist in 1P.
#
# What this DOESN'T cover (and won't, in this file):
#   - SSH Key items (`<CLUSTER>_CEPH_ANSIBLE_IAC_SSH_KEY`). Per ADR-010,
#     these are created via `op item create --category "SSH Key"
#     --ssh-generate-key=ed25519`. The TF provider's `ssh_key` category
#     accepts metadata but cannot generate the keypair inline (verified
#     against provider v2.x). Continue creating these via op CLI.
#   - DR Document items (RGW TLS cert/key, admin keyring). Populated by
#     `mise run capture` after a successful deploy — they're snapshots
#     of bootstrap-side files, not secrets TF would author.

# Look up the cluster's target vault. Vault must exist before apply
# (the data source errors loudly if it doesn't).
data "onepassword_vault" "target" {
  name = var.vault
}

# Password items — one per entry in local.secrets. local.secrets is the
# canonical map of password types this module manages (see main.tf).
# Currently 5 entries: ops, dashboard, grafana, s3_restic_access, s3_restic_secret.
resource "onepassword_item" "password" {
  for_each = local.secrets

  vault    = data.onepassword_vault.target.uuid
  title    = each.value
  category = "password"

  password_recipe {
    length  = 32
    letters = true
    digits  = true
    symbols = false
  }

  lifecycle {
    # Don't recreate the password when the recipe definition is touched —
    # the actual password value is what matters, and rotating it should be
    # an explicit `terragrunt taint` + `apply`, not an incidental side effect
    # of editing this file.
    ignore_changes = [password_recipe]
  }
}
