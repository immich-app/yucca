# Cilium for the hybrid prod cluster. Talos sets cni:none + proxy:disabled, so
# nodes stay NotReady until this lands the datapath.
#
# Native routing + autoDirectNodeRoutes: all WORKERS share the kube VLAN-10 L2
# (10.40.10.0/24), so Cilium installs a direct route to each peer's podCIDR via the
# peer's fabric nodeIP — pod east-west rides the 50G fabric with NO overlay and NO
# BGP. CPs run no workloads (no pod east-west), so the mixed CP nodeIP (hcloud
# private) is harmless.
#
# securityContext + cgroup blocks are MANDATORY on Talos. Ref: Talos "Deploying Cilium".

ipam:
  mode: kubernetes

# Tunnel (geneve) routing. The cluster spans two L2 domains — CPs on the kube-cp
# hcloud net, workers on the fabric VLAN — bridged only by NetBird. Native routing
# can't span that; a geneve overlay carries pod↔pod over whatever host-to-host path
# exists (the 50G fabric for worker↔worker, NetBird for CP↔worker). East-west still
# rides the fabric, just encapsulated (~50B overhead, negligible at 50G).
routingMode: tunnel
tunnelProtocol: geneve

# Masquerade pod traffic to non-pod destinations (internet, node IPs); pod↔pod is
# tunnelled so it isn't masqueraded. ip-masq-agent excludes only the pod CIDR, so the
# geneve underlay + node-IP traffic egressing wt0 is SNAT'd to the node's NetBird
# address (which WireGuard accepts). Requires BPF masquerade on.
enableIPv4Masquerade: true
bpf:
  masquerade: true
ipMasqAgent:
  enabled: true
  config:
    nonMasqueradeCIDRs:
      - ${pod_cidr}
    masqLinkLocal: false

# No LoadBalancer service exposure yet (ingress comes with Flux later) — keep L2
# announcements off so Cilium doesn't ARP for VIPs it shouldn't.
l2announcements:
  enabled: false

# NORTH-SOUTH (future): the fabric leaf already speaks BGP (transit). When ingress
# lands, enable the BGP control plane here and add CiliumBGPClusterConfig peering
# the leaf IRB (10.40.10.1) to advertise LoadBalancer/ingress VIPs into the fabric
# — no L2 announcements needed. East-west stays on autoDirectNodeRoutes above.
# bgpControlPlane:
#   enabled: true

# kube-proxy replacement → Talos KubePrism (localhost:7445), stable apiserver
# endpoint with no kube-proxy.
kubeProxyReplacement: ${kube_proxy_replacement}
%{ if kube_proxy_replacement ~}
k8sServiceHost: localhost
k8sServicePort: 7445
%{ endif ~}

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

%{ if hubble ~}
hubble:
  relay:
    enabled: true
  ui:
    enabled: false
%{ else ~}
hubble:
  enabled: false
%{ endif ~}
