# Talos sets cni:none + proxy:disabled; nodes NotReady until this lands.
#
# Geneve tunnel routing: cluster spans two L2 domains (CPs VLAN 11, workers VLAN
# 10, routed by spine IRBs) — autoDirectNodeRoutes is same-L2 only. Spine LB ECMP
# + DSR are independent of routing mode.
#
# MTU: auto-detected, DELIBERATE — lowest device MTU is wt0 (WireGuard 1280) →
# ~1230 pod MTU; pods egress wt0 to o11y (vmauth 10.69.0.10). Forcing jumbo
# (tried 2026-07-28) black-holes large frames over WG+NAT (PMTUD dies) and takes
# o11y remote-write down; fabric flows are 1500-bound anyway.
#
# securityContext + cgroup blocks are MANDATORY on Talos ("Deploying Cilium").

ipam:
  mode: kubernetes

routingMode: tunnel
tunnelProtocol: geneve

# ip-masq-agent excludes only the pod CIDR, so traffic egressing wt0 is SNAT'd
# to the node's mesh address (WireGuard accepts it). Requires BPF masquerade.
enableIPv4Masquerade: true
# netkit needs kernel ≥6.8 + BPF host routing (both hold). NOT switchable in
# place — nodes were rolled (drain → label → reboot) on 2026-07-27. bpf.tproxy
# must stay off (broken under netkit, cilium#39892).
bpf:
  datapathMode: netkit
  masquerade: true
ipMasqAgent:
  enabled: true
  config:
    nonMasqueradeCIDRs:
      - ${pod_cidr}
    masqLinkLocal: false

l2announcements:
  enabled: false

# DSR: backend node replies straight to the client sourced from the VIP — no
# SNAT/hairpin, client IPs preserved; lets LB services run externalTrafficPolicy:
# Cluster. VIP-sourced replies need the lb-return-route DaemonSet's policy
# routing (all workers). hybrid = DSR TCP / SNAT UDP (UDP MTU pitfalls); geneve
# dispatch is the supported DSR mode under geneve routing.
loadBalancer:
  mode: hybrid
  dsrDispatch: geneve

# North-south: worker speakers peer the spine VLAN-10 IRB (10.40.10.1, iBGP AS
# 402421), advertising LB /32s covered by the transit 69.48.224.0/24. BGP CRs +
# LoadBalancerIPPools live in bgp/*.yaml, not here. Worker-only peering.
bgpControlPlane:
  enabled: true

kubeProxyReplacement: ${kube_proxy_replacement}
%{ if kube_proxy_replacement ~}
k8sServiceHost: localhost
k8sServicePort: 7445
%{ endif ~}

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

%{ if hubble ~}
hubble:
  relay:
    enabled: true
  ui:
    enabled: true # exposed NetBird-only via the hubble-ui-internal LB Service (flux tree)
%{ else ~}
hubble:
  enabled: false
%{ endif ~}
