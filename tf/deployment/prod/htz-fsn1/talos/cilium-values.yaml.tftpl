# Cilium for the prod cluster. Talos sets cni:none + proxy:disabled, so nodes
# stay NotReady until this lands the datapath.
#
# TUNNEL (geneve) routing at jumbo MTU. The cluster spans two L2 domains — CPs
# on the kube-cp VLAN (11), workers on the kube VLAN (10) — routed by the spine
# IRBs. A geneve overlay carries pod↔pod (and host↔pod, e.g. apiserver→pod
# webhooks) over the routed node-to-node path with the pod identity in-band —
# which autoDirectNodeRoutes (same-L2 only) can't span. The jumbo MTU (below),
# the spine LB ECMP (core-fabric), and DSR (loadBalancer, below) are retained
# and independent of the routing mode.
#
# securityContext + cgroup blocks are MANDATORY on Talos. Ref: Talos "Deploying Cilium".

ipam:
  mode: kubernetes

# Tunnel (geneve) routing — see the header. East-west (incl. host↔pod across
# the two VLANs) rides the fabric encapsulated; geneve overhead is ~50B, so at
# the jumbo MTU below pods still get ~8950 (vs the 1230 the old auto-detected
# MTU clamped us to over wt0).
routingMode: tunnel
tunnelProtocol: geneve

# Explicit datapath MTU (the fabric bond/VLAN MTU; switch L2 is 9216, IRBs
# 9202). NEVER auto-detect: Cilium's detection takes the lowest MTU across its
# devices, and wt0 (NetBird's WireGuard, 1280) once clamped every pod route to
# 1230. In tunnel mode pods get this minus the ~50B geneve header.
MTU: ${fabric_mtu}

# Masquerade pod traffic to non-pod destinations (internet, node IPs); pod↔pod is
# tunnelled so it isn't masqueraded. ip-masq-agent excludes only the pod CIDR, so
# node-IP traffic egressing wt0 (NetBird, the operator plane) is still SNAT'd to
# the node's mesh address (which WireGuard accepts). Requires BPF masquerade on.
enableIPv4Masquerade: true
# netkit datapath (replaces veth; zero-overhead netns crossing, tcx attachments).
# Needs kernel >= 6.8 + BPF host routing — both hold here (Talos 6.18, KPR + BPF
# masquerade). NOT switchable in place: every node was rolled onto netkit
# (drain → label → reboot, via a transitional label-gated CiliumNodeConfig) on
# 2026-07-27 before this became the cluster-wide default. bpf.tproxy must stay
# off (broken under netkit, cilium#39892).
bpf:
  datapathMode: netkit
  masquerade: true
ipMasqAgent:
  enabled: true
  config:
    nonMasqueradeCIDRs:
      - ${pod_cidr}
    masqLinkLocal: false

# LoadBalancer VIPs are advertised into the fabric via BGP (below), not L2 — keep L2
# announcements off so Cilium doesn't ARP for VIPs it shouldn't.
l2announcements:
  enabled: false

# DSR (direct server return) for LoadBalancer/NodePort TCP: the node a flow
# lands on (spine ECMP) geneve-dispatches it to the backend's node, and THAT
# node replies straight to the client sourced from the VIP — no SNAT, no
# hairpin back through the ingress node, client IPs preserved. This decouples
# ECMP width from pod placement, so LB services can run externalTrafficPolicy:
# Cluster (every worker advertises the VIP) without a second hop's SNAT.
# VIP-sourced replies leave via the fabric on whichever node emits them — the
# lb-return-route DaemonSet's policy routing runs on all workers. hybrid =
# DSR for TCP, SNAT for UDP (avoids UDP MTU pitfalls); geneve dispatch is the
# supported DSR mode under tunnel/geneve routing.
loadBalancer:
  mode: hybrid
  dsrDispatch: geneve

# NORTH-SOUTH — the worker BGP speakers peer the spine's VLAN-10 IRB (10.40.10.1, iBGP
# AS 402421) and advertise LoadBalancer /32s from the public pools; the core reaches
# each VIP via its /32 and they're covered by the transit 69.48.224.0/24 advertisement.
# The CiliumBGPClusterConfig / PeerConfig / Advertisement + LoadBalancerIPPools are
# applied as CRs (bgp/*.yaml), not templated here. Peering is on the fabric — worker-only.
bgpControlPlane:
  enabled: true

# kube-proxy replacement → Talos KubePrism (localhost:7445), stable apiserver
# endpoint with no kube-proxy.
kubeProxyReplacement: ${kube_proxy_replacement}
%{ if kube_proxy_replacement ~}
k8sServiceHost: localhost
k8sServicePort: 7445
%{ endif ~}

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

%{ if hubble ~}
hubble:
  relay:
    enabled: true
  ui:
    enabled: true # exposed NetBird-only via the hubble-ui-internal LB Service (flux tree)
%{ else ~}
hubble:
  enabled: false
%{ endif ~}
