# Cilium values for Talos. securityContext + cgroup blocks are MANDATORY on
# Talos (Talos docs "Deploying Cilium CNI").

ipam:
  mode: kubernetes

# LB-IPAM + L2 announcements answer ARP for LoadBalancer VIPs on the node bond
# (no external LB); the ingress Gateway claims 10.10.10.16.
l2announcements:
  enabled: true
# kube-proxy-replacement installs need the LB class; harmless otherwise.
externalIPs:
  enabled: true

# kube-proxy replacement → Talos KubePrism (localhost:7445).
kubeProxyReplacement: ${kube_proxy_replacement}
%{ if kube_proxy_replacement ~}
k8sServiceHost: localhost
k8sServicePort: 7445
%{ endif ~}

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

%{ if hubble ~}
hubble:
  relay:
    enabled: true
  ui:
    enabled: false
%{ else ~}
hubble:
  enabled: false
%{ endif ~}
