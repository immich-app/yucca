# op:// references resolved by `op run --env-file=tf/.env -- ...`
# Contains NO literal secrets — just pointers to 1P items.
#
# OP_SERVICE_ACCOUNT_TOKEN is the superuser SA (read+write to yucca_tf_*).
# Used by Terraform via the onepassword provider (once re-enabled) AND by
# direct op CLI calls (op item, op inject) nested inside the op run shell.
export OP_SERVICE_ACCOUNT_TOKEN="op://yucca_tf_dev/yucca_futo_1pass_superuser_service_account/password"

# S3 credentials for the shared `yucca-tf-state` bucket (OVH eu-west-par).
# Consumed by OpenTofu's S3 backend via standard AWS env vars.
export AWS_ACCESS_KEY_ID="op://yucca_tf/TF_STATE_S3_ACCESS_KEY/password"
export AWS_SECRET_ACCESS_KEY="op://yucca_tf/TF_STATE_S3_SECRET_KEY/password"

# Cloudflare API token for the dns stack (futo.cloud zone; Zone:Read +
# DNS:Edit). The cloudflare provider reads this env var directly. Lives in
# the *_manual vault: it is a human-created token, and the yucca_tf copies
# are duplicated (one archived) which breaks op:// title resolution.
export CLOUDFLARE_API_TOKEN="op://yucca_tf_manual/CLOUDFLARE_API_TOKEN/password"

# ─── staging/talos app secrets (secrets.tf) ─────────────────────────────
# COMMENTED ON PURPOSE: `op run` resolves EVERY ref in this file, so an op://
# ref to an item that doesn't exist yet fails the whole stack. Uncomment each
# line once its 1P item exists. Until then the TF_VARs fall back to their empty
# defaults — the staging apps deploy but with non-functional OIDC / object
# storage / metrics egress (the agreed "slice first, real values later" path).
#
# yucca-api + yucca-admin-api OIDC clients — register in the staging IdP, store
# in yucca_tf_staging_manual (human-managed):
# export TF_VAR_yucca_oidc_client_id="op://yucca_tf_staging_manual/YUCCA_OIDC_CLIENT/username"
# export TF_VAR_yucca_oidc_client_secret="op://yucca_tf_staging_manual/YUCCA_OIDC_CLIENT/credential"
# export TF_VAR_yucca_oidc_admin_client_id="op://yucca_tf_staging_manual/YUCCA_OIDC_ADMIN_CLIENT/username"
# export TF_VAR_yucca_oidc_admin_client_secret="op://yucca_tf_staging_manual/YUCCA_OIDC_ADMIN_CLIENT/credential"
#
# michael RGW (S3) creds — NOT manual: the `svc-yucca-restic` user is already
# created by the ceph Ansible (ansible/ceph, sietch cluster) with predetermined
# keys stored in 1P. michael is that restic consumer, so just point it at the
# existing items (SA-readable, verified).
export TF_VAR_yucca_rgw_access_key_id="op://yucca_tf_dev/SIETCH_CEPH_S3_SVC_YUCCA_RESTIC_ACCESS_KEY/password"
export TF_VAR_yucca_rgw_secret_access_key="op://yucca_tf_dev/SIETCH_CEPH_S3_SVC_YUCCA_RESTIC_SECRET_KEY/password"

# vmagent + vlagent → o11y vmauth bearer token (the superuser SA reads
# o11y_tf_prod; verified).
export TF_VAR_vmauth_remote_write_password="op://o11y_tf_prod/VICTORIAMETRICS_VMAUTH_PASSWORD/password"

# Cloudflare API token for cert-manager DNS-01 (same item the dns stack uses).
export TF_VAR_cloudflare_api_token="op://yucca_tf_manual/CLOUDFLARE_API_TOKEN/password"
